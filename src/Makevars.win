PKG_CFLAGS=$(C_VISIBILITY)
PKG_CXXFLAGS=$(CXX_VISIBILITY)
PKG_CPPFLAGS=-I../inst/swipl/include -D_REENTRANT -D__SWI_PROLOG__ -D__WINDOWS__ -D_WINDOWS -D_WIN32_WINNT=0x0600 -DWIN64
PKG_LIBS=-L../inst/swipl/bin -lswipl -lgmp -lz -lm -lpthread -lws2_32 -lpsapi -lwinmm -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32

all: $(SHLIB)
$(SHLIB): ../build/done
RcppExports.o: ../build/done
rswipl.o: ../build/done

../build/done:
	-patch -N -p2 < ../inst/patch/02-clib.patch
	-patch -N -p2 < ../inst/patch/03-cpp.patch
	-patch -N -p2 < ../inst/patch/04-cpp.patch
	mkdir -p ../build
	mkdir -p ../inst/swipl/bin
	rm -f ../inst/swipl/bin/*.dll
	( cd ../build ;\
		CC="$(CC)" CFLAGS="$(subst -pedantic,,$(subst -Wstrict-prototypes,,$(CFLAGS)))"\
		CXX="$(CXX)" CXXFLAGS="$(CXXFLAGS)" CPPFLAGS="$(CPPFLAGS)" LDFLAGS="$(LDFLAGS)" cmake\
		-DCMAKE_INSTALL_PREFIX=../inst/swipl\
		-DSWIPL_PACKAGES_GUI=OFF -DSWIPL_PACKAGES_ODBC=OFF\
		-DINSTALL_DOCUMENTATION=OFF -DSWIPL_PACKAGES_PYTHON=OFF\
		-DBUILD_TESTING=ON -DINSTALL_TESTS=ON\
		-DUSE_GMP=ON\
		-DMINGW_ROOT=$(R_TOOLS_SOFT)\
		-DLibArchive_INCLUDE_DIRS="-I."\
		-DLibArchive_LIBRARIES="-larchive -lnettle -lxml2 -liconv -lregex -lexpat -llzma -lzstd -llz4 -lbz2 -lz -lbcrypt -lws2_32"\
		-DCMAKE_BUILD_TYPE=Release -S ../src/swipl-devel )
	# dos2unix all Makefiles
	find ../build -name Makefile -exec sed -i 's/\r//' \{\} \;
	make -C ../build install
	-( cd ../build ; ctest --output-on-failure )
	rm ../inst/swipl/bin/swipl.exe
	rm ../inst/swipl/bin/swipl-win.exe
	rm ../inst/swipl/bin/swipl-ld.exe
	touch ../build/done
